{
  "name": "just-follow-feed",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:local": "node .\\scripts\\launch-local.mjs",
    "stop:local": "node .\\scripts\\stop-local.mjs",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File .\\scripts\\install-autostart.ps1",
    "autostart:remove": "powershell -ExecutionPolicy Bypass -File .\\scripts\\remove-autostart.ps1",
    "check:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-local.ps1",
    "audit:sidecar": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit-sidecar.ps1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "next": "16.3.5",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  }
}
